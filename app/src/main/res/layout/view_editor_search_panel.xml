<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/toggle_replace_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_replace"
                android:padding="8dp"
                android:src="@drawable/baseline_keyboard_arrow_down_24" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColorHint="?android:attr/textColorHint" />

            <TextView
                android:id="@+id/search_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text=""
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/search_prev_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_previous"
                android:padding="8dp"
                android:src="@drawable/baseline_keyboard_arrow_up_24" />

            <ImageButton
                android:id="@+id/search_next_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_next"
                android:padding="8dp"
                android:src="@drawable/baseline_keyboard_arrow_down_24" />

            <ImageButton
                android:id="@+id/search_close_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="8dp"
                android:src="@drawable/baseline_close_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replace_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Space
                android:layout_width="36dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/replace_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent"
                android:hint="@string/replace_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColorHint="?android:attr/textColorHint" />

            <ImageButton
                android:id="@+id/replace_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/replace"
                android:padding="8dp"
                android:src="@drawable/ic_replace_24" />

            <ImageButton
                android:id="@+id/replace_all_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/replace_all"
                android:padding="8dp"
                android:src="@drawable/ic_replace_all_24" />
        </LinearLayout>
    </LinearLayout>

</merge>
